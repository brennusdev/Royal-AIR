generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  active
  pending
  suspended
  deleted
}

enum PlatformRole {
  candidate
  reviewer
  recruiter
  organization_admin
  platform_admin
}

enum OrganizationStatus {
  active
  pending
  suspended
}

enum OrganizationRole {
  owner
  admin
  member
}

enum ConsentType {
  terms_of_service
  privacy_notice
  profile_sharing
  ai_processing
}

enum LearningPathStatus {
  draft
  published
  archived
}

enum LearningPlanStatus {
  active
  paused
  completed
}

enum LearningStepStatus {
  not_started
  in_progress
  studied
}

enum ChallengeStatus {
  draft
  published
  archived
}

enum ChallengeAttemptStatus {
  in_progress
  submitted
}

enum EvidenceStatus {
  self_reported
  pending
  reviewed
  contested
  revoked
}

enum EmailActionPurpose {
  verify_email
  reset_password
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  displayName        String
  passwordHash       String?
  status             AccountStatus           @default(pending)
  roles              UserRole[]
  candidateProfile   CandidateProfile?
  organizationMember OrganizationMember[]
  consentRecords     ConsentRecord[]
  sessions           Session[]
  emailActionTokens  EmailActionToken[]
  learningPlans      CandidateLearningPlan[]
  portfolioEvidence PortfolioEvidence[]
  challengeAttempts ChallengeAttempt[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailActionToken {
  id         String             @id @default(cuid())
  userId     String
  tokenHash  String             @unique
  purpose    EmailActionPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("email_action_tokens")
}

model UserRole {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model CandidateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  headline       String?
  region         String?
  isDiscoverable Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  status    OrganizationStatus   @default(pending)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(member)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  type        ConsentType
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, grantedAt])
  @@map("consent_records")
}

model Competency {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String
  versions    CompetencyVersion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("competencies")
}

model CompetencyVersion {
  id                       String                   @id @default(cuid())
  competencyId             String
  version                  Int
  title                    String
  description              String
  competency               Competency               @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  learningPathCompetencies LearningPathCompetency[]
  createdAt                DateTime                 @default(now())

  @@unique([competencyId, version])
  @@index([competencyId])
  @@map("competency_versions")
}

model LearningPath {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  title        String
  description  String
  targetRole   String
  outcome      String
  status       LearningPathStatus       @default(draft)
  competencies LearningPathCompetency[]
  plans        CandidateLearningPlan[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@map("learning_paths")
}

model LearningPathCompetency {
  id                  String                  @id @default(cuid())
  learningPathId      String
  competencyVersionId String
  position            Int
  whyThisStep         String
  practiceTask        String
  estimatedMinutes    Int
  resourceTitle       String?
  resourceUrl         String?
  learningPath        LearningPath            @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  competencyVersion   CompetencyVersion       @relation(fields: [competencyVersionId], references: [id], onDelete: Restrict)
  progress            CandidateLearningStep[]

  @@unique([learningPathId, competencyVersionId])
  @@unique([learningPathId, position])
  @@map("learning_path_competencies")
}

model CandidateLearningPlan {
  id             String                  @id @default(cuid())
  userId         String
  learningPathId String
  status         LearningPlanStatus      @default(active)
  isActive       Boolean                 @default(true)
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath   LearningPath            @relation(fields: [learningPathId], references: [id], onDelete: Restrict)
  steps          CandidateLearningStep[]

  @@unique([userId, learningPathId])
  @@index([userId, isActive, status])
  @@map("candidate_learning_plans")
}

model CandidateLearningStep {
  id                       String                 @id @default(cuid())
  learningPlanId           String
  learningPathCompetencyId String
  status                   LearningStepStatus     @default(not_started)
  startedAt                DateTime?
  studiedAt                DateTime?
  updatedAt                DateTime               @updatedAt
  learningPlan             CandidateLearningPlan  @relation(fields: [learningPlanId], references: [id], onDelete: Cascade)
  learningPathCompetency   LearningPathCompetency @relation(fields: [learningPathCompetencyId], references: [id], onDelete: Restrict)

  @@unique([learningPlanId, learningPathCompetencyId])
  @@index([learningPlanId, status])
  @@map("candidate_learning_steps")
}

model PortfolioEvidence {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String
  url         String?
  status      EvidenceStatus @default(self_reported)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("portfolio_evidence")
}

model ChallengeAttempt {
  id             String                @id @default(cuid())
  userId         String
  challengeId    String
  challengeVersion Int
  acceptanceCriteria String[]
  rubricCriteria String[]
  status         ChallengeAttemptStatus @default(in_progress)
  approach       String?               @db.Text
  submissionUrl  String?
  startedAt      DateTime              @default(now())
  submittedAt    DateTime?
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge      Challenge             @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@unique([userId, challengeId])
  @@index([userId, status, updatedAt])
  @@map("challenge_attempts")
}

model Challenge {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  context           String          @db.Text
  description       String          @db.Text
  difficulty        String
  estimatedMinutes  Int
  version           Int             @default(1)
  status            ChallengeStatus @default(draft)
  acceptanceCriteria String[]
  rubricCriteria    String[]
  attempts          ChallengeAttempt[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, title])
  @@map("challenges")
}
