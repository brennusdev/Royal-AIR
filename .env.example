# Local development only. Keep these values aligned with docker-compose.yml.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
POSTGRES_DB=evidence_platform
DATABASE_URL=postgresql://platform:platform_dev_password@localhost:5432/evidence_platform?schema=public
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@example.invalid
TERMS_VERSION=draft-v1
PRIVACY_VERSION=draft-v1
SESSION_COOKIE_SECURE=false

# Optional integrations are intentionally not enabled in the foundation.
AI_PROVIDER_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
