    "@platform/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1"
